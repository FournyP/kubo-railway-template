# Build-time arguments (used to configure Kubo)
KUBO_SWARM_TCP_ADDRESS_IPV4="/ip4/0.0.0.0/tcp/4001"
KUBO_SWARM_TCP_ADDRESS_IPV6="/ip6/::/tcp/4001"
KUBO_SWARM_UDP_ADDRESS_IPV4="/ip4/0.0.0.0/udp/4001/quic"
KUBO_SWARM_UDP_ADDRESS_IPV6="/ip6/::/udp/4001/quic"
KUBO_ANNOUNCE="/ip4/0.0.0.0/tcp/4001"
KUBO_API_ADDRESS="/ip6/::/tcp/5001"

# RPC API authentication. Use Mode A or Mode B (B wins if both are set).

# Mode A — single bearer token
KUBO_API_AUTH_SECRET=""
KUBO_API_ALLOWED_PATHS=["/api/v0"]

# Mode B — full API.Authorizations object (multiple users, basic/bearer)
KUBO_API_AUTHORIZATIONS='{"alice":{"AuthSecret":"basic:alice:pw","AllowedPaths":["/api/v0/add","/api/v0/pin"]},"bob":{"AuthSecret":"bearer:tokenB","AllowedPaths":["/api/v0"]}}'

# Runtime environment
DATA_PATH="/data/ipfs"
